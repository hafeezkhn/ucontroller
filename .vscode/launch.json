{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex-Debug (Active Folder)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "external",
            "cwd": "${fileDirname}",
            "executable": "${fileDirname}/main.elf",
            "gdbTarget": "127.0.0.1:1234",
            "gdbPath": "gdb-multiarch",
            "runToEntryPoint": "reset_handler"
        }
    ]
}